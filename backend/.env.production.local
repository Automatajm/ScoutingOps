# ===== .env.production.local - ARREGLADO =====
# Configuración para SIMULAR producción localmente SIN SSL en DB
API_URL=https://10.0.0.19:8000/api
ENVIRONMENT=production
VERSION=1.0.0

# ✅ URLs BASE - LOCAL simulando producción
BASE_URL=https://10.0.0.19:8000
PUBLIC_URL=https://10.0.0.19:8080

# Base de datos LOCAL (SIN SSL - como development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Pest_Control
DB_USER=postgres
DB_PASSWORD=0824
DB_SSL_ENABLED=false

# Pool de conexiones (optimizado para producción)
DB_POOL_MAX=25
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# Configuración del servidor
PORT=8000
HOST=0.0.0.0

# Logging (mínimo en producción - pero habilitado para debug)
LOG_QUERIES=false
LOG_ERRORS=true
LOG_REQUESTS=false
PRETTY_LOGS=false

# Seguridad (máxima en producción)
SALT_ROUNDS=15
JWT_SECRET=super-secret-jwt-key-for-production-testing
TOKEN_EXPIRATION=12h

# Timeouts (estrictos)
SERVER_TIMEOUT=20000
REQUEST_TIMEOUT=10000

# ✅ CORS específico para LOCAL (simulando producción)
CORS_ORIGIN=https://10.0.0.19:8080,https://localhost:8080,https://172.24.16.1:8080

# ✅ SSL/TLS Configuración LOCAL - SOLO PARA SERVIDOR WEB (tus certificados actuales)
SSL_ENABLED=true
SSL_CERT_PATH=./backend/certs/cert.pem
SSL_KEY_PATH=./backend/certs/key.pem

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Monitoreo y métricas
MONITORING_ENABLED=true
METRICS_ENDPOINT=/metrics
HEALTH_CHECK_INTERVAL=30000
APM_ENABLED=false

# Backup y recuperación
DB_BACKUP_ENABLED=false
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_RETENTION_DAYS=30

# CDN y optimizaciones (deshabilitado para local)
CDN_URL=
STATIC_ASSETS_URL=

# ✅ Flutter Web
FLUTTER_WEB_USE_SKIA=true
FLUTTER_WEB_AUTO_DETECT=false
FLUTTER_WEB_RENDERER=canvaskit
FLUTTER_WEB_CACHE_ASSETS=true

# Seguridad adicional
HELMET_ENABLED=true
CORS_CREDENTIALS=true
SESSION_SECURE=true
COOKIE_SECURE=true

# Performance
GZIP_ENABLED=true
ETAG_ENABLED=true
CACHE_CONTROL_MAX_AGE=31536000

# Notificaciones (deshabilitado para local)
EMAIL_SERVICE_ENABLED=false
SMS_SERVICE_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false