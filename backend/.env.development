# ===== .env.development =====
# Configuración para desarrollo local con HTTPS
# IMPORTANTE: URLs HTTPS para coherencia con Flutter Web

# ✅ API PRINCIPAL - HTTPS
API_URL=https://10.0.0.19:8000/api
ENVIRONMENT=development
VERSION=1.0.0

# ✅ URLs BASE - HTTPS
BASE_URL=https://10.0.0.19:8000
PUBLIC_URL=https://10.0.0.19:8000

# Base de datos local
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Pest_Control
DB_USER=postgres
DB_PASSWORD=0824

# Pool de conexiones (optimizado para desarrollo)
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_IDLE_TIMEOUT=60000
DB_CONNECTION_TIMEOUT=15000
DB_STATEMENT_TIMEOUT=60000
DB_QUERY_TIMEOUT=60000

# Configuración del servidor
PORT=8000
HOST=0.0.0.0

# Logging (habilitado en desarrollo)
LOG_QUERIES=true
LOG_ERRORS=true
LOG_REQUESTS=true
PRETTY_LOGS=true

# Seguridad (desarrollo)
SALT_ROUNDS=10
JWT_SECRET=pest-control-dev-secret-2024
TOKEN_EXPIRATION=7d

# Timeouts (generosos para desarrollo)
SERVER_TIMEOUT=30000
REQUEST_TIMEOUT=15000

# ✅ CORS específico para Flutter Web HTTPS
CORS_ORIGIN=https://localhost:8080,https://127.0.0.1:8080,https://10.0.0.19:8080,http://localhost:8080,http://127.0.0.1:8080,http://10.0.0.19:8080

# Desarrollo específico
HOT_RELOAD=true
AUTO_OPEN_BROWSER=false

# ✅ SSL/TLS Configuración
SSL_ENABLED=true
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# ✅ Flutter Web específico
FLUTTER_WEB_USE_SKIA=false
FLUTTER_WEB_AUTO_DETECT=true
FLUTTER_WEB_RENDERER=html