# ===== .env.staging =====
# Configuración para ambiente de pruebas con HTTPS
API_URL=https://staging-pestcontrol.costaanalytics.com/api
ENVIRONMENT=staging
VERSION=1.0.0

# ✅ URLs BASE - HTTPS
BASE_URL=https://staging-pestcontrol.costaanalytics.com
PUBLIC_URL=https://staging-pestcontrol.costaanalytics.com

# Base de datos de staging
DB_HOST=staging-db.costaanalytics.com
DB_PORT=5432
DB_NAME=Pest_Control_Staging
DB_USER=staging_user
DB_PASSWORD=staging_secure_password_2024

# Pool de conexiones (intermedio)
DB_POOL_MAX=15
DB_POOL_MIN=3
DB_IDLE_TIMEOUT=45000
DB_CONNECTION_TIMEOUT=12000
DB_STATEMENT_TIMEOUT=45000
DB_QUERY_TIMEOUT=45000

# Configuración del servidor
PORT=8000
HOST=0.0.0.0

# Logging (selectivo en staging)
LOG_QUERIES=false
LOG_ERRORS=true
LOG_REQUESTS=false
PRETTY_LOGS=false

# Seguridad (staging)
SALT_ROUNDS=12
JWT_SECRET=pest-control-staging-secret-secure-2024
TOKEN_EXPIRATION=24h

# Timeouts (más estrictos)
SERVER_TIMEOUT=25000
REQUEST_TIMEOUT=12000

# ✅ CORS específico para staging
CORS_ORIGIN=https://staging-app.costaanalytics.com,https://staging-admin.costaanalytics.com

# ✅ SSL/TLS Configuración
SSL_ENABLED=true
SSL_CERT_PATH=/etc/ssl/certs/staging-cert.pem
SSL_KEY_PATH=/etc/ssl/private/staging-key.pem

# Staging específico
MONITORING_ENABLED=true
METRICS_ENDPOINT=/metrics
HEALTH_CHECK_INTERVAL=30000

# ✅ Flutter Web staging
FLUTTER_WEB_USE_SKIA=true
FLUTTER_WEB_AUTO_DETECT=true
FLUTTER_WEB_RENDERER=canvaskit

# =====================================