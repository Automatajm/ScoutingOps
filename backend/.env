# ===== .env.production =====
# Configuración para producción con HTTPS
API_URL=https://api.pestcontrol.costaanalytics.com/api
ENVIRONMENT=production
VERSION=1.0.0

# ✅ URLs BASE - HTTPS PRODUCCIÓN
BASE_URL=,https://172.24.16.1:8080/api #https://api.pestcontrol.costaanalytics.com
PUBLIC_URL=https://172.24.16.1:8080 #https://app.pestcontrol.costaanalytics.com

# Base de datos de producción
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Pest_Control
DB_USER=postgres
DB_PASSWORD=0824

# Pool de conexiones (optimizado para producción)
DB_POOL_MAX=25
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_STATEMENT_TIMEOUT=30000
DB_QUERY_TIMEOUT=30000

# Configuración del servidor
PORT=8000
HOST=0.0.0.0

# Logging (mínimo en producción)
LOG_QUERIES=false
LOG_ERRORS=true
LOG_REQUESTS=false
PRETTY_LOGS=false

# Seguridad (máxima en producción)
SALT_ROUNDS=15
JWT_SECRET=${JWT_SECRET_FROM_SECRETS_MANAGER}
TOKEN_EXPIRATION=12h

# Timeouts (estrictos)
SERVER_TIMEOUT=20000
REQUEST_TIMEOUT=10000

# ✅ CORS específico para producción
CORS_ORIGIN=https://localhost:8080,https://127.0.0.1:8080,https://10.0.0.19:8080,http://localhost:8080,http://127.0.0.1:8080,http://10.0.0.19:8080

# ✅ SSL/TLS Configuración PRODUCCIÓN
SSL_ENABLED=true
SSL_CERT_PATH=./certs/cert.pem
SSL_KEY_PATH=./certs/key.pem

# Rate limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Monitoreo y métricas
MONITORING_ENABLED=true
METRICS_ENDPOINT=/metrics
HEALTH_CHECK_INTERVAL=30000
APM_ENABLED=true
LOG_LEVEL=error

# Backup y recuperación
DB_BACKUP_ENABLED=true
DB_BACKUP_SCHEDULE=0 2 * * *
DB_BACKUP_RETENTION_DAYS=30

# CDN y optimizaciones
CDN_URL=https://cdn.pestcontrol.costaanalytics.com
STATIC_ASSETS_URL=https://assets.pestcontrol.costaanalytics.com

# ✅ Flutter Web producción optimizada
FLUTTER_WEB_USE_SKIA=true
FLUTTER_WEB_AUTO_DETECT=false
FLUTTER_WEB_RENDERER=canvaskit
FLUTTER_WEB_CACHE_ASSETS=true

# Seguridad adicional
HELMET_ENABLED=true
CORS_CREDENTIALS=true
SESSION_SECURE=true
COOKIE_SECURE=true

# Performance
GZIP_ENABLED=true
ETAG_ENABLED=true
CACHE_CONTROL_MAX_AGE=31536000

# Notificaciones
EMAIL_SERVICE_ENABLED=true
SMS_SERVICE_ENABLED=true
PUSH_NOTIFICATIONS_ENABLED=true

# =====================================