# ===== .env.staging.local =====
# Configuración para SIMULAR staging localmente
API_URL=https://10.0.0.19:8000/api
ENVIRONMENT=staging
VERSION=1.0.0

# ✅ URLs BASE - LOCAL simulando staging
BASE_URL=https://10.0.0.19:8000
PUBLIC_URL=https://10.0.0.19:8080

# Base de datos LOCAL (misma que development)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Pest_Control
DB_USER=postgres
DB_PASSWORD=0824

# Pool de conexiones (intermedio - settings de staging)
DB_POOL_MAX=15
DB_POOL_MIN=3
DB_IDLE_TIMEOUT=45000
DB_CONNECTION_TIMEOUT=12000
DB_STATEMENT_TIMEOUT=45000
DB_QUERY_TIMEOUT=45000

# Configuración del servidor
PORT=8000
HOST=0.0.0.0

# Logging (selectivo en staging)
LOG_QUERIES=false
LOG_ERRORS=true
LOG_REQUESTS=false
PRETTY_LOGS=false

# Seguridad (staging)
SALT_ROUNDS=12
JWT_SECRET=pest-control-staging-secret-secure-2024
TOKEN_EXPIRATION=24h

# Timeouts (más estrictos que development)
SERVER_TIMEOUT=25000
REQUEST_TIMEOUT=12000

# ✅ CORS específico para LOCAL (simulando staging)
CORS_ORIGIN=https://10.0.0.19:8080,https://localhost:8080

# ✅ SSL/TLS Configuración LOCAL (tus certificados actuales)
SSL_ENABLED=true
SSL_CERT_PATH=C:/Users/owner/Desktop/pestcontrol/backend/certs/cert.pem
SSL_KEY_PATH=C:/Users/owner/Desktop/pestcontrol/backend/certs/key.pem

# Staging específico
MONITORING_ENABLED=true
METRICS_ENDPOINT=/metrics
HEALTH_CHECK_INTERVAL=30000

# ✅ Flutter Web staging
FLUTTER_WEB_USE_SKIA=true
FLUTTER_WEB_AUTO_DETECT=true
FLUTTER_WEB_RENDERER=canvaskit
FLUTTER_WEB_CACHE_ASSETS=true

# Rate limiting (intermedio)
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=150

# Performance (intermedio)
GZIP_ENABLED=true
ETAG_ENABLED=true
CACHE_CONTROL_MAX_AGE=86400

# Servicios (deshabilitado para local)
EMAIL_SERVICE_ENABLED=false
SMS_SERVICE_ENABLED=false
PUSH_NOTIFICATIONS_ENABLED=false

# Seguridad adicional
HELMET_ENABLED=true
CORS_CREDENTIALS=true
SESSION_SECURE=true
COOKIE_SECURE=true