{
  "name": "Pest Control App - Costa Analytics",
  "short_name": "PestControl",
  "description": "Sistema completo para control de plagas con escáner de códigos de barras integrado. Escanea lotes en campo de forma rápida y eficiente - Costa Analytics",
  "start_url": ".",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#0175C2",
  "theme_color": "#0175C2",
  "lang": "es-DO",
  "dir": "ltr",
  
  "prefer_related_applications": false,
  "offline_enabled": true,
  "related_applications": [],
  
  "categories": [
    "productivity", 
    "business", 
    "utilities",
    "agriculture",
    "monitoring"
  ],
  
  "icons": [
    {
      "src": "icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/Icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/Icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.png",
      "sizes": "16x16",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  
  "shortcuts": [
    {
      "name": "Nuevo Monitoreo",
      "short_name": "Nuevo",
      "description": "Crear un nuevo registro de monitoreo de plagas",
      "url": "/#/monitoreo",
      "icons": [
        {
          "src": "icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Escanear Código",
      "short_name": "Escanear",
      "description": "Abrir escáner de códigos de barras directamente",
      "url": "/#/scanner",
      "icons": [
        {
          "src": "icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Reportes",
      "short_name": "Reportes",
      "description": "Ver reportes y estadísticas de monitoreo",
      "url": "/#/reportes",
      "icons": [
        {
          "src": "icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Acceso rápido al panel principal",
      "url": "/#/dashboard",
      "icons": [
        {
          "src": "icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  
  "screenshots": [
    {
      "src": "icons/screenshot-mobile.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Interfaz principal en dispositivos móviles"
    },
    {
      "src": "icons/screenshot-scanner.png", 
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Escáner de códigos de barras en tiempo real"
    },
    {
      "src": "icons/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard completo en PC y laptops"
    }
  ],
  
  "permissions": [
    "camera",
    "storage"
  ],
  
  "features": [
    {
      "name": "camera",
      "required": false
    },
    {
      "name": "storage",
      "required": false
    }
  ],
  
  "iarc_rating_id": "",
  
  "edge_side_panel": {
    "preferred_width": 400
  },
  
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png", ".gif", ".webp"],
        "text/csv": [".csv"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/vnd.ms-excel": [".xls"],
        "application/json": [".json"],
        "text/plain": [".txt"]
      },
      "icons": [
        {
          "src": "icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "launch_type": "single-client"
    }
  ],
  
  "protocol_handlers": [
    {
      "protocol": "web+pestcontrol",
      "url": "/?action=barcode&data=%s"
    },
    {
      "protocol": "web+monitoring",
      "url": "/?action=monitor&data=%s"
    }
  ],
  
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  
  "handle_links": "preferred",
  "capture_links": "new-client",
  
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text", 
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*", 
            "text/plain",
            "text/csv",
            "application/json",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ]
        }
      ]
    }
  },
  
  "widgets": [
    {
      "name": "Quick Scanner",
      "short_name": "Scanner",
      "description": "Acceso rápido al escáner de códigos",
      "tag": "quick-scanner",
      "template": "quick-scanner-template",
      "ms_ac_template": "adaptive-card.json",
      "data": "scanner-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "icons/widget-scanner.png",
          "sizes": "256x256",
          "label": "Widget de escáner rápido"
        }
      ],
      "icons": [
        {
          "src": "icons/Icon-192.png",
          "sizes": "192x192"
        }
      ],
      "auth": false,
      "update": 3600
    }
  ],
  
  "screenshots_urls": {
    "mobile": [
      "icons/screenshot-mobile.png",
      "icons/screenshot-scanner.png"
    ],
    "desktop": [
      "icons/screenshot-desktop.png"
    ]
  },
  
  "developer": {
    "name": "Costa Analytics",
    "url": "https://costaanalytics.com"
  },
  
  "version": "1.0.0",
  
  "manifest_version": 3,
  
  "gcm_sender_id": "103953800507",
  
  "start_page": "index.html",
  
  "offline_enabled": true,
  
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval' 'inline-speculation-rules' https://cdn.jsdelivr.net; object-src 'self'; connect-src 'self' https: ws: wss:;"
  },
  
  "permissions_policy": {
    "camera": ["self"],
    "microphone": ["self"],
    "geolocation": ["self"]
  },
  
  "installation": {
    "supported_platforms": [
      "chrome_web_store",
      "play",
      "chromeos_play",
      "webapp",
      "windows",
      "f_droid"
    ]
  },
  
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://pestcontrol.costaanalytics.com/manifest.json"
    }
  ],
  
  "prefer_related_applications": false,
  
  "app": {
    "background": {
      "scripts": ["background.js"]
    }
  },
  
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "assets/*",
        "*.png",
        "*.jpg",
        "*.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  
  "chrome_settings_overrides": {},
  
  "chrome_url_overrides": {},
  
  "commands": {
    "open-scanner": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Abrir escáner de códigos"
    },
    "new-monitoring": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Nuevo monitoreo"
    }
  },
  
  "externally_connectable": {
    "matches": [
      "https://pestcontrol.costaanalytics.com/*",
      "https://api.pestcontrol.costaanalytics.com/*",
      "https://10.0.0.19:8000/*",
      "https://localhost:8000/*"
    ]
  },
  
  "web_app_origin_association": [
    {
      "origin": "https://pestcontrol.costaanalytics.com"
    },
    {
      "origin": "https://10.0.0.19:8000"
    }
  ],
  
  "cross_origin_embedder_policy": {
    "value": "credentialless"
  },
  
  "cross_origin_opener_policy": {
    "value": "same-origin-allow-popups"
  }
}