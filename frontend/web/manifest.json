{
  "name": "Pest Control - Costa Analytics",
  "short_name": "PestControl",
  "description": "Sistema completo para control de plagas con escáner de códigos de barras integrado",
  "start_url": ".",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0175C2",
  "theme_color": "#0175C2",
  "lang": "es-DO",
  "dir": "ltr",
  
  "categories": [
    "productivity", 
    "business", 
    "utilities",
    "agriculture"
  ],
  
  "icons": [
    {
      "src": "icons/Icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/Icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/Icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/Icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "favicon.png",
      "sizes": "16x16",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  
  "shortcuts": [
    {
      "name": "Nuevo Monitoreo",
      "short_name": "Nuevo",
      "description": "Crear un nuevo registro de monitoreo",
      "url": "/#/monitoreo",
      "icons": [
        {
          "src": "icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Escanear Código",
      "short_name": "Escanear",
      "description": "Abrir escáner de códigos de barras",
      "url": "/#/scanner",
      "icons": [
        {
          "src": "icons/Icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  
  "screenshots": [
    {
      "src": "icons/screenshot-mobile.png",
      "sizes": "540x960",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Interfaz móvil"
    },
    {
      "src": "icons/screenshot-desktop.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Dashboard desktop"
    }
  ],
  
  "file_handlers": [
    {
      "action": "/import",
      "accept": {
        "image/*": [".jpg", ".jpeg", ".png"],
        "text/csv": [".csv"],
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet": [".xlsx"],
        "application/json": [".json"]
      }
    }
  ],
  
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text", 
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*", 
            "text/csv",
            "application/json",
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
          ]
        }
      ]
    }
  },
  
  "permissions_policy": {
    "camera": ["self"],
    "microphone": ["self"]
  }
}